# Copy to `.env` and fill in. `.env` is git-ignored; never commit real secrets.
# App settings are read in chatbot/src/chatbot/config.py (from C04).
# Database settings are also used by Compose and db/init/01_roles.sql.

# --- App --------------------------------------------------------------------
APP_ENV=local                      # local | ci | prod
LOG_LEVEL=INFO                     # DEBUG shows the exact context sent to the model
LOG_FORMAT=console                 # console | json

# --- Postgres (pgvector image) ----------------------------------------------
# Three roles on purpose (see docs/ARCHITECTURE.md, "Database roles"):
POSTGRES_HOST=localhost            # `postgres` inside docker compose
POSTGRES_PORT=5432
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot_owner        # owns the schema, runs migrations only
POSTGRES_PASSWORD=change-me
# Optional bootstrap-superuser password; defaults to POSTGRES_PASSWORD locally.
# POSTGRES_ADMIN_PASSWORD=change-me-admin
APP_DB_USER=chatbot_app            # history, memory, audit inserts
APP_DB_PASSWORD=change-me
RO_DB_USER=chatbot_ro              # SELECT on curated views only; used by tools
RO_DB_PASSWORD=change-me
SEED_DEMO_DATA=true               # Compose bootstrap loads synthetic fixtures; false to skip

# --- LLM --------------------------------------------------------------------
# Models are written as provider:model. Adding a provider = one adapter class.
LLM_PRIMARY=anthropic:claude-sonnet-5-5
# Empty values keep comments on their own line: Compose would read an inline one as the value.
# LLM_FALLBACKS: comma-separated, tried in order, e.g. openai:<model>
LLM_FALLBACKS=
LLM_SUMMARY_MODEL=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
AGENT_MAX_STEPS=8                  # hard stop for the tool loop

# --- Context management -----------------------------------------------------
CONTEXT_STRATEGY=sliding_window    # full | sliding_window (compact_tools and summary are planned)
CONTEXT_MAX_INPUT_TOKENS=60000     # approximate budget including system prompt and tool schemas
CONTEXT_KEEP_LAST_TURNS=10         # stored turns to keep, in addition to the current turn

# --- Retrieval --------------------------------------------------------------
# EMBEDDING_MODEL: provider:model, decided in C18
EMBEDDING_MODEL=
EMBEDDING_DIM=
RERANKER=none                      # none | local | api, decided in C20
RETRIEVAL_CANDIDATES=40            # per search leg, before fusion
RETRIEVAL_PAGE_SIZE=5              # results returned to the model per page

# --- Memory (off until users ask for it) ------------------------------------
MEMORY_ENABLED=false

# --- Tracing ----------------------------------------------------------------
TRACING_ENABLED=false              # turn on once the Langfuse project keys are set
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Limits -----------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=20
COST_CAP_USD_PER_USER_PER_DAY=2.00

# --- Backend and frontend ---------------------------------------------------
BACKEND_PORT=8000                 # host port; container always uses 8000
BACKEND_URL=http://localhost:8000  # local UI; Compose overrides this to http://backend:8000
FRONTEND_PORT=8501                # host port; container always uses 8501
AUTH_MODE=dev                      # dev: static tokens below; replaced by SSO later
AUTH_DEV_TOKENS=dev-token-alice:alice,dev-token-bob:bob
